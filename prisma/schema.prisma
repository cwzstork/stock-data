// 台股篩選器 — Phase 1 schema
//
// 設計原則：時間是「鍵」不是「欄位名」。
// 不要出現 close_20180124 這種欄位；日期存在 trade_date，查詢時當參數傳。
// 滾動彙總（N 年平均／最低）一律查詢時用視窗函數現算，不落地。

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起，連線字串不再寫在這裡：
//   migrate / introspect 的連線 → prisma.config.ts 的 datasource.url（走 DIRECT_URL）
//   執行期的連線             → src/lib/prisma.ts 的 driver adapter（走 DATABASE_URL，pooled）
datasource db {
  provider = "postgresql"
}

/// 股票主檔
model Stock {
  stockId   String   @id @map("stock_id") @db.VarChar(10)
  name      String   @map("stock_name") @db.VarChar(60)
  /// twse=上市 / tpex=上櫃 / emerging=興櫃
  market    String   @db.VarChar(10)
  industry  String?  @map("industry_category") @db.VarChar(60)
  updatedAt DateTime @updatedAt @map("updated_at")

  daily     StockDaily[]
  capital   StockCapital[]
  quarterly StockQuarterly[]
  dividend  StockDividend[]
  annual    StockAnnual[]

  @@index([market])
  @@index([industry])
  @@map("stock")
}

/// 股本（季頻）
/// 來源：FinMind TaiwanStockBalanceSheet，type = CapitalStock（origin_name = 股本合計）
///
/// 股本隨財報公告才更新，不是日頻資料。原始篩選器上的「20180124 股本(百萬)」
/// 實際語意是「該日期當時最新的股本」，所以這裡存財報基準日，
/// 查詢時取 reportDate <= 指定日期的最新一筆。
model StockCapital {
  stockId    String   @map("stock_id") @db.VarChar(10)
  /// 財報基準日（每季季底）
  reportDate DateTime @map("report_date") @db.Date
  /// 股本，單位：元（上游原始單位，不在寫入時換算，避免精度流失）
  capital    BigInt

  stock Stock @relation(fields: [stockId], references: [stockId], onDelete: Cascade)

  @@id([stockId, reportDate])
  @@index([reportDate])
  @@map("stock_capital")
}

/// 日頻行情與評價指標
/// 來源：FinMind TaiwanStockPrice（價量）＋ TaiwanStockPER（殖利率／本益比／股價淨值比）
model StockDaily {
  stockId   String   @map("stock_id") @db.VarChar(10)
  tradeDate DateTime @map("trade_date") @db.Date

  /// 收盤價
  close    Decimal? @db.Decimal(12, 4)
  /// 成交量（股）
  volume   BigInt?
  /// 成交金額（元）
  turnover BigInt?

  /// 殖利率(%)，交易所公告
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(8, 4)
  /// 本益比（近四季）
  per           Decimal? @db.Decimal(10, 2)
  /// 股價淨值比
  pbr           Decimal? @db.Decimal(10, 2)

  stock Stock @relation(fields: [stockId], references: [stockId], onDelete: Cascade)

  @@id([stockId, tradeDate])
  // 篩選器最常見的查法是「某一天的全市場」，所以日期要能快速定位
  @@index([tradeDate])
  @@index([tradeDate, dividendYield])
  @@map("stock_daily")
}

/// 季頻財報
/// 來源：證交所 / 櫃買中心 t187ap06（綜合損益表）＋ t187ap07（資產負債表）
///
/// 兩件事影響查詢寫法：
///   1. 損益表是「累計數」——Q2 是上半年累計，不是單季。
///      要單季就拿相鄰兩季累計相減；要年化就乘以 4/季別。
///   2. 資產負債表是「期末時點數」，不是累計，不能相減。
///
/// 金額單位一律「元」（上游是千元，寫入時 ×1000，整數運算不失真），
/// 跟 stock_capital 對齊。兩張表單位不同才是真正會出事的地雷。
model StockQuarterly {
  stockId   String   @map("stock_id") @db.VarChar(10)
  /// 季底日：2026Q2 → 2026-06-30
  periodEnd DateTime @map("period_end") @db.Date

  // ── 損益表（累計）──
  revenue         BigInt?
  grossProfit     BigInt?  @map("gross_profit")
  operatingIncome BigInt?  @map("operating_income")
  pretaxIncome    BigInt?  @map("pretax_income")
  netIncome       BigInt?  @map("net_income")
  /// 歸屬於母公司業主。算 ROE 要用這個，不是本期淨利
  netIncomeParent BigInt?  @map("net_income_parent")
  /// 基本每股盈餘（元），累計
  eps             Decimal? @db.Decimal(10, 2)

  // ── 資產負債表（期末時點）──
  totalAssets       BigInt?  @map("total_assets")
  totalLiabilities  BigInt?  @map("total_liabilities")
  totalEquity       BigInt?  @map("total_equity")
  equityParent      BigInt?  @map("equity_parent")
  /// 每股參考淨值（元）
  bookValuePerShare Decimal? @map("book_value_per_share") @db.Decimal(12, 2)

  stock Stock @relation(fields: [stockId], references: [stockId], onDelete: Cascade)

  @@id([stockId, periodEnd])
  @@index([periodEnd])
  @@map("stock_quarterly")
}

/// 配息紀錄（每一次除息一列）
/// 來源：FinMind TaiwanStockDividend（逐檔抓，涵蓋 ETF）
///
/// 為什麼不直接用交易所公告的殖利率就好：
///   1. 交易所的 BWIBBU 報表完全不含 ETF，384 檔 ETF/ETN 一筆殖利率都沒有
///   2. 除息後交易所的股利基數有更新延遲（台積電 2026-09-16 除息，
///      到 09-24 的公告殖利率仍未計入那 7 元）
///   3. 算不出 5 年／10 年平均殖利率
/// 有了逐筆紀錄，這三件事都能自己算。
model StockDividend {
  stockId String   @map("stock_id") @db.VarChar(10)
  /// 除息（權）交易日。優先取現金股利的除息日，只配股票股利時取除權日。
  /// 台股除權除息幾乎都同一天，分開的情況極少，這裡以現金為準。
  exDate  DateTime @map("ex_date") @db.Date

  /// 現金股利合計＝盈餘配息＋公積配息，元/股
  cash     Decimal @db.Decimal(12, 6)
  /// 股票股利合計＝盈餘配股＋公積配股，元/股（面額 10 元）
  stockDiv Decimal @map("stock_div") @db.Decimal(12, 6)

  /// 現金股利發放日
  payDate DateTime? @map("pay_date") @db.Date
  /// 所屬期別，例如「114年第3季」或「115」。季配與年配的寫法不同，原樣保留
  period  String?   @db.VarChar(30)

  stock Stock @relation(fields: [stockId], references: [stockId], onDelete: Cascade)

  @@id([stockId, exDate])
  @@index([exDate])
  @@map("stock_dividend")
}

/// 逐檔回補的進度記錄。
///
/// 免費層要逐檔打 API，三千多檔跑不完一次，所以要能中斷續跑。
/// 沒有這張表的話，「沒有配息紀錄的公司」會每次都被重抓。
/// 刻意不設外鍵：主檔暫時少一檔時不該把進度一起刪掉。
model BackfillLog {
  stockId  String   @map("stock_id") @db.VarChar(10)
  /// dividend / financials / balance
  dataset  String   @db.VarChar(30)
  syncedAt DateTime @map("synced_at")
  /// 抓到幾列，0 表示這檔真的沒有資料（不是失敗）
  rows     Int

  @@id([stockId, dataset])
  @@index([dataset, syncedAt])
  @@map("backfill_log")
}

/// 存起來的篩選條件。
///
/// 存的是「條件」不是「結果」——結果隔天股價一變就不準了，
/// 條件則永遠可以重跑。內容就是網址的 query string，
/// 所以存下來的東西跟你分享網址給別人時是同一份東西。
model SavedFilter {
  id        Int      @id @default(autoincrement())
  /// 唯一，存同名條件就是覆蓋
  name      String   @unique @db.VarChar(60)
  /// URL query string，例如 gmMin=40&roeMin=15&debtMax=50
  query     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("saved_filter")
}

/// 年度彙總。
///
/// 為什麼不存十年日頻明細：
///   3,081 檔 × 每年約 245 個交易日 × 10 年 ≈ 690 萬列，含索引超過 1 GB，
///   直接撞爆 Neon 免費層的 0.5 GB。
///   而實際要用的「歷史殖利率」「近 N 年最低本益比」「歷史高低點」
///   全部只需要年度層級的數字——30,810 列、約 5 MB，兩百分之一。
///   日頻明細另外以 Parquet 外存，要畫走勢圖或回測時再載入。
model StockAnnual {
  stockId String @map("stock_id") @db.VarChar(10)
  year    Int

  /// 年均收盤價。算歷史殖利率的分母用這個，不是年末價
  avgClose  Decimal? @map("avg_close") @db.Decimal(14, 4)
  high      Decimal? @db.Decimal(14, 4)
  low       Decimal? @db.Decimal(14, 4)
  /// 年末最後一個交易日收盤
  lastClose Decimal? @map("last_close") @db.Decimal(14, 4)
  /// 該年有成交的交易日數。用來判斷這一年的資料完不完整
  days      Int

  /// 以下來自 TaiwanStockPER，ETF 與興櫃不公告，會是空的
  avgPer   Decimal? @map("avg_per") @db.Decimal(10, 2)
  minPer   Decimal? @map("min_per") @db.Decimal(10, 2)
  avgPbr   Decimal? @map("avg_pbr") @db.Decimal(10, 2)
  minPbr   Decimal? @map("min_pbr") @db.Decimal(10, 2)
  avgYield Decimal? @map("avg_yield") @db.Decimal(8, 4)
  maxYield Decimal? @map("max_yield") @db.Decimal(8, 4)

  stock Stock @relation(fields: [stockId], references: [stockId], onDelete: Cascade)

  @@id([stockId, year])
  @@index([year])
  @@map("stock_annual")
}
